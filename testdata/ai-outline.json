      "markdown": "# Title\n\n## A\n\n### B\n\n## C\n",
      "headings": [
        { "id": "toc-heading-1", "text": "A", "level": 2 },
        { "id": "toc-heading-2", "text": "B", "level": 3 },
        { "id": "toc-heading-3", "text": "C", "level": 2 }
      ]
    },
    {
      "id": "no-leading-h1",
      "markdown": "## Real\n\n## After\n",
      "headings": [
        { "id": "toc-heading-0", "text": "Real", "level": 2 },
        { "id": "toc-heading-1", "text": "After", "level": 2 }
      ]
    },
    {
      "id": "code-fence-ignored",
      "markdown": "## Real\n\n```\n# not a heading\n```\n\n## After\n",
      "headings": [
        { "id": "toc-heading-0", "text": "Real", "level": 2 },
        { "id": "toc-heading-1", "text": "After", "level": 2 }
      ]
    },
    {
      "id": "math-line-skipped",
