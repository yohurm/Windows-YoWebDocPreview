{
  "name": "yohu-webdocpreview-ui",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --filter @yohu/shell dev",
    "build": "pnpm --filter @yohu/shell build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint:deps": "node ../scripts/check-ui-deps.mjs",
    "lint": "pnpm lint:deps"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "solid-js": "^1.9.5"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@types/node": "^24.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-solid": "^2.11.6",
    "vitest": "^3.1.0",
    "@tauri-apps/cli": "^2.9.0",
    "markdown-it": "^14.1.0",
    "@types/markdown-it": "^14.1.2",
    "dompurify": "^3.2.4"
  },
  "workspaces": [
    "packages/*",
    "packages/modules/*",
    "apps/*"
  ]
